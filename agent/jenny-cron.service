[Unit]
Description=Jenny - LSR BOD Assistant (scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jenny/app
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Ho_Chi_Minh
Environment=JENNY_SECRETS_DIR=/opt/jenny/config/secrets
Environment=JENNY_WORKDIR=/opt/jenny/workdir
Environment=GOOGLE_APPLICATION_CREDENTIALS=/opt/jenny/config/secrets/google-service-account.json
ExecStart=/opt/jenny/venv/bin/python -m jenny.scheduler_main
Restart=always
RestartSec=10
StandardOutput=append:/opt/jenny/logs/jenny-cron.log
StandardError=append:/opt/jenny/logs/jenny-cron.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=Jenny - LSR BOD Assistant (bot event listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jenny/app
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Ho_Chi_Minh
Environment=JENNY_SECRETS_DIR=/opt/jenny/config/secrets
Environment=JENNY_WORKDIR=/opt/jenny/workdir
EnvironmentFile=/opt/jenny/config/secrets/agent.env
ExecStart=/opt/jenny/venv/bin/python -m jenny.events_main
Restart=always
RestartSec=10
StandardOutput=append:/opt/jenny/logs/jenny-events.log
StandardError=append:/opt/jenny/logs/jenny-events.log

[Install]
WantedBy=multi-user.target
